# Copy to .env (git-ignored) and fill in. Leave DO_MODEL_ACCESS_KEY empty to run in demo mode
# with simulated models: no account or network needed.
DO_MODEL_ACCESS_KEY=

# Force demo mode even when a key is set (1 = simulated models only)
MOCK_MODE=0

# Guardrails (defaults shown)
COMPARES_PER_HOUR=10
CONCURRENT_PER_IP=2
DAILY_SPEND_CEILING_USD=5
MAX_MODELS=4
MAX_PROMPT_CHARS=8000
MAX_OUTPUT_TOKENS_CAP=2000
MODEL_TIMEOUT_S=30
FIRST_TOKEN_TIMEOUT_S=15
